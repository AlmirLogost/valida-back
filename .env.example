# Copie este arquivo para ".env" e preencha com os valores reais.
# NUNCA coloque valores reais aqui neste .env.example nem comite o seu .env.

# --- Banco de dados (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=valida_v2
DB_USER=postgres
DB_PASSWORD=
# "true" só se o banco exigir SSL (normalmente produção/hospedagem)
DB_SSL=false

# --- Autenticação ---
# OBRIGATÓRIA. O servidor não inicia sem ela (ver server.js).
# Gere uma chave longa e aleatória, única por ambiente (local, produção etc).
# Nunca reaproveite a mesma chave em dois ambientes diferentes.
JWT_SECRET=

# Liga/desliga o login por nome (sem celular) pra colaboradores antigos que
# ainda não têm celular cadastrado. Opcional — se não definida, fica LIGADA
# por padrão. Só o valor "false" desliga. Ver back/DEPLOY.md: desligar depois
# que todos os colaboradores tiverem celular preenchido.
LOGIN_POR_NOME=

# --- Servidor ---
# Porta em que o back vai escutar (padrão 3001 se não definida)
PORT=3001

# --- E-mail (recuperação de senha) ---
RESEND_API_KEY=
# URL do front, usada para montar o link de "redefinir senha" no e-mail
FRONTEND_URL=http://localhost:3000

# Copie este arquivo para ".env" e preencha com os valores reais.
# NUNCA coloque valores reais aqui neste .env.example nem comite o seu .env.

# --- Banco de dados (PostgreSQL) ---
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
# "true" só se o banco exigir SSL (normalmente produção/hospedagem)
DB_SSL=

# --- Autenticação ---
# OBRIGATÓRIA. O servidor não inicia sem ela. Chave longa e aleatória,
# única por ambiente (nunca a mesma em local e produção).
JWT_SECRET=
# OBRIGATÓRIA. Cifra o PIN que fica guardado só até quem pediu ver uma vez
# (pedidos "pin" e "cad"). Chave longa e aleatória, única por ambiente.
PIN_CIFRA_CHAVE=

# --- Servidor ---
# Porta do back (padrão 3001)
PORT=
# Origem do front liberada no CORS e usada no link de "redefinir senha".
# Vazio = só a mesma origem (o back serve o front compilado).
FRONTEND_URL=

# --- Envio (D17) ---
# E-mail e WhatsApp são SEMPRE simulados nesta fase: nada sai para fora.
# Deixe "true". (Não existe envio real ligado no código.)
ENVIO_SIMULADO=true
# Opcional, só no local: arquivo (fora do git) onde as mensagens simuladas
# ficam gravadas, para abrir o link de teste. Ex.: ../BACKUPS-VALIDA/envios.jsonl
ENVIO_SIMULADO_ARQUIVO=

# --- Asaas (D14: não será usada) ---
# Webhook desligado (404). Deixe "false".
WEBHOOK_ASAAS_ATIVO=false

# --- Fotos (scripts/migrar_fotos.js; upload na Etapa 1B) ---
# Pasta absoluta FORA do app.
FOTOS_DIR=

# Saíram na Etapa 1: LOGIN_POR_NOME (D11, inseguro) e RESEND_API_KEY (D17).
